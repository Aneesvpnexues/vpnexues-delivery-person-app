{
  "name": "vpnexues-backend",
  "version": "0.1.0",
  "private": true,
  "description": "VP Nexues delivery-partner API (Fastify + PostgreSQL, AWS-ready)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js",
    "db:inspect": "tsx --env-file-if-exists=.env scripts/inspect-db.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p test/tsconfig.json --noEmit",
    "test": "node --experimental-transform-types --test test/sessionSecurity.test.ts test/authApiContract.test.ts test/databaseSafety.test.ts",
    "admin:create": "tsx --env-file-if-exists=.env scripts/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/client-sns": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^11.2.2",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
