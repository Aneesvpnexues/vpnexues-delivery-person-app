# Copy to .env for local development. On AWS these come from the task definition / Secrets Manager.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5199,http://localhost:5200,capacitor://localhost,https://localhost

# --- Database (leave unset until Postgres exists; the API still boots) ---
# Local:  docker compose up -d db   then   npm run migrate
# DATABASE_URL=postgres://vpnexues:vpnexues@localhost:5432/vpnexues
# RDS:    DATABASE_URL=postgres://USER:PASS@xxxx.ap-south-1.rds.amazonaws.com:5432/vpnexues  and DB_SSL=true
DB_SSL=false
DB_POOL_MAX=10

# --- Auth ---
# Leave JWT_SECRET and DATA_ENCRYPTION_KEY commented out locally: the app falls back to built-in dev-only values.
# Real deployments must set both (Render generates them; on AWS they come from Secrets Manager).
#   JWT_SECRET:          openssl rand -base64 48
#   DATA_ENCRYPTION_KEY: openssl rand -base64 32   (must decode to exactly 32 bytes)
# JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_DEV_ECHO=true
# DATA_ENCRYPTION_KEY=

# --- AWS ---
AWS_REGION=ap-south-1
# S3_DOCUMENTS_BUCKET=vpnexues-partner-documents-dev
SMS_PROVIDER=log
SMS_SENDER_ID=VPNXUS
